# Database configuration
# For local XAMPP MySQL, username is 'root' and password is empty
DATABASE_URL=mysql+mysqlconnector://root:@127.0.0.1:3306/university_erp

# Groq API credentials
# Get your free key at https://console.groq.com/
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# Cache configuration (leave empty to use in-memory fallback)
# Set to redis://localhost:6379 or Upstash URL if you have Redis running
REDIS_URL=

# Application Settings
API_RATE_LIMIT=10/minute
PORT=8000
HOST=127.0.0.1
